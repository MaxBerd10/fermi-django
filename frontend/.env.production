# Same-origin deploy: the frontend and Django backend sit behind the same
# host (e.g. fermi.uz), so the browser always calls "/api/v1" on its own
# origin — no CORS setup needed. production-server.mjs's Node process then
# proxies "/api/v1/*" straight through to wherever Django actually runs,
# controlled by the FERMI_API_BASE_URL server env var (default
# http://127.0.0.1:8000, i.e. Django on the same box) — set that at deploy
# time, not this file, if Django ends up on a different host or port.
VITE_API_BASE_URL=/api/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# iMentor's own server is the same physical box as this one (imentor.uz resolves to
# the same IP) -- FerMI has its own dedicated partner API key there. Flip this on now
# that /test and /keyslar actually have a real key configured (see
# .env.production.local on the server for IMENTOR_API_KEY_B64).
VITE_FEATURE_IMENTOR=true

# Real secrets (OpenAI key, iMentor key) live in .env.production.local on the actual
# server — that file is gitignored and never committed, so a public-repo leak (which is
# what got the previous OpenAI key auto-revoked) can't happen again. See DEPLOY_SECRETS.md.
