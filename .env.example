DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=fermi
DB_USER=fermi
DB_PASSWORD=fermi_dev_only
DB_HOST=localhost
DB_PORT=5434

# Reuses the machine's existing Redis (see docker-compose.yml) with a dedicated DB index.
REDIS_URL=redis://localhost:6379/1

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Leave EMAIL_HOST empty for local dev -- emails print to the console instead
# of trying to send for real. See deploy/fermi-django.env.example for the
# production values.
EMAIL_HOST=
