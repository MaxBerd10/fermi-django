# Copy to /etc/fermi-django.env on the server (chmod 600, owned by root),
# referenced by deploy/systemd/fermi-django.service. Never commit the real
# file -- same rule as frontend/DEPLOY_SECRETS.md.

DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=fjsti.uz,www.fjsti.uz

DB_NAME=fermi
DB_USER=fermi
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/1

# Same-box, same-origin deploy (browser -> nginx -> production-server.mjs ->
# gunicorn, all on one domain) -- CORS isn't actually exercised in this setup,
# but set it to the real domain anyway in case something ever calls the API
# from a different origin.
CORS_ALLOWED_ORIGINS=https://fjsti.uz,https://www.fjsti.uz

FRONTEND_URL=https://fjsti.uz
DEFAULT_FROM_EMAIL=no-reply@fjsti.uz

# Leave EMAIL_HOST empty to keep printing emails to the systemd journal
# instead of sending them (fine until password-reset/verification emails
# actually need to reach real inboxes -- see config/settings.py's own
# comment on this).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
